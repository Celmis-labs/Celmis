#!/bin/sh
# Prints {"Authorization": "Bearer <token>"} for Claude Code's `headersHelper`.
#
# The plugin's own server entry does NOT use this: it takes the address and the token
# from the options Claude Code saved (`/plugin configure celmis-code@celmis`). Claude
# Code removes every environment variable with TOKEN, SECRET, PASSWORD, KEY or AUTH in
# its name from the helper of a plugin's or a project's server, so a helper cannot read
# CELMIS_TOKEN there. This script is for a server entry YOU write at user or local scope,
# whose helper gets your full environment (plugin README, "Using your own server entry").
# Name it by an absolute path, quoted inside the JSON string because a shell runs it:
#   "headersHelper": "\"/home/you/.local/bin/celmis-auth-header\""
#
# The token comes from the OS keychain when one is available, else from
# $CELMIS_TOKEN. It is printed only inside that JSON object, on stdout, which
# Claude Code reads and does not log. Nothing else is ever written to stdout.
#
#   macOS:  copy the token, then
#             printf 'add-generic-password -U -s celmis-token -a %s -w %s\n' "$USER" "$(pbpaste | tr -cd 'A-Za-z0-9._~+/=-')" | security -i && pbcopy </dev/null
#           (do not type the value at the `security` prompt instead: it keeps only
#           the first 128 characters, which cuts an MCP token)
#   Linux:  secret-tool store --label celmis-token service celmis-token
#
# Exit 1 (message on stderr, never the token) when no token is found; the MCP
# server then simply fails to connect and the agent falls back to Grep.
set -u

# A bearer token over plain http crosses the network readable. Refuse unless the
# server is on this machine. The check is on CELMIS_URL, the address of the entry
# this helper serves; it cannot see the entry's own url, so set CELMIS_URL to it.
url="${CELMIS_URL:-}"
case "$url" in
  "" | https://* ) ;;
  http://localhost | http://localhost:* | http://localhost/* \
  | http://127.0.0.1 | http://127.0.0.1:* | http://127.0.0.1/* \
  | "http://[::1]" | "http://[::1]:"* | "http://[::1]/"* ) ;;
  *)
    echo "celmis-auth-header: CELMIS_URL is not https (only localhost may use http); the token is not sent" >&2
    exit 1 ;;
esac

token=""
case "$(uname -s 2>/dev/null)" in
  Darwin)
    if command -v security >/dev/null 2>&1; then
      token=$(security find-generic-password -s celmis-token -w 2>/dev/null || true)
    fi ;;
  Linux)
    if command -v secret-tool >/dev/null 2>&1; then
      token=$(secret-tool lookup service celmis-token 2>/dev/null || true)
    fi ;;
esac
[ -n "$token" ] || token="${CELMIS_TOKEN:-}"

if [ -z "$token" ]; then
  echo "celmis-auth-header: no token in the keychain (service celmis-token) or in CELMIS_TOKEN" >&2
  exit 1
fi
# A bearer token is URL-safe base64 or a JWT. Anything else would need JSON
# escaping, and is not a Celmis token: refuse rather than emit broken JSON.
case "$token" in
  *[!A-Za-z0-9._~+/=-]*)
    echo "celmis-auth-header: the token has characters a Celmis token never has" >&2
    exit 1 ;;
esac
# An MCP token is a JWT: three non-empty parts, two dots. One that starts like a
# JWT but is not has been cut short (macOS's `security ... -w` prompt keeps 128
# characters). Say so, with its length and never its value, rather than let the
# server answer 401 invalid_token.
case "$token" in
  eyJ*)
    case "$token" in
      *..* | *. | *.*.*.* ) cut=1 ;;
      *.*.* ) cut=0 ;;
      * ) cut=1 ;;
    esac
    if [ "$cut" = 1 ]; then
      echo "celmis-auth-header: the token looks cut short (${#token} characters, not three parts); store it again as the plugin README shows" >&2
      exit 1
    fi ;;
esac
printf '{"Authorization":"Bearer %s"}\n' "$token"
