# ── Celmis — example environment ────────────────────────────────────
#
# Every variable the production stack actually sets, with the values removed
# and the reasoning left in. Copy to `.env`, run `./scripts/init-env.sh`, and
# the stack comes up.
#
# NOT "fill in the four generated secrets", which is what this said and which
# sent people looking for four blanks. `init-env.sh` generates fourteen —
# POSTGRES_PASSWORD, CELMIS_JWT_SECRET, NEXTAUTH_SECRET, MCP_JWT_SECRET,
# CREDENTIAL_MASTER_KEY, CELMIS_MASTER_KEY, CELMIS_OPS_TOKEN,
# LITELLM_MASTER_KEY, LITELLM_SALT_KEY, REVIEW_WEBHOOK_SECRET,
# REVIEW_GITLAB_TOKEN, REVIEW_BITBUCKET_SECRET, SANDBOX_TOKEN and
# GRAFANA_ADMIN_PASSWORD — and you fill in none of them by hand. What is left
# for a person is the handful further down that cannot be generated: a
# provider key, an OAuth client, a VAPID pair.
#
# There is no GEMINI_API_KEY here on purpose. Provider keys are per-WORKSPACE
# and are entered in the interface (Settings → LLM Setup), because two
# workspaces on one installation may legitimately bill two different
# accounts. The environment is only a fallback for a single-tenant box that
# never opens the page; if you want that, set GEMINI_API_KEY yourself and it
# will be used when a workspace has no key of its own.

# ── Database ────────────────────────────────────────────────────────
POSTGRES_USER=celmis
# generate: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=celmis
# Only if you want Postgres reachable from the host, e.g. 5433 to avoid a
# local install already on 5432. Not needed by the stack itself.
POSTGRES_HOST_PORT=

# ── Secrets — generate all four, never reuse one for another ────────
#
# Anyone holding CELMIS_JWT_SECRET can mint a session token for any user,
# including an admin. The application REFUSES TO START if this is one of the
# shipped placeholders, so leaving it as-is fails loudly rather than quietly.
# openssl rand -hex 32
CELMIS_JWT_SECRET=
# openssl rand -hex 32
NEXTAUTH_SECRET=
# The MCP surface is what an external agent connects to; give it its own
# value so rotating it does not sign every browser session out.
# openssl rand -hex 32
MCP_JWT_SECRET=
#
# NEVER ROTATE OR LOSE THIS ONE. It encrypts every stored git token and LLM
# key. A new value does not "reset" them — it makes every one of them
# permanently undecryptable, and they must all be re-entered by hand.
# Fernet, NOT hex: 32 raw bytes in url-safe base64 (44 chars). `openssl
# rand -hex 32` produces 64 hex chars, which Fernet rejects at the first
# credential read — and the UI shows only "Failed to fetch".
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_MASTER_KEY=

# ── Addresses ───────────────────────────────────────────────────────
#
# LEAVE THESE UNSET unless you have a fixed public URL. Blank is not a
# missing value here — it is the working one. The app derives its own
# address from the request it is answering: the browser bundle asks for a
# relative `/backend`, and NextAuth trusts the Host header (`trustHost` in
# web/auth.ts). One image then serves any hostname.
#
# A value here overrides all of that, for every visitor. This file used to
# ship `http://localhost:3000`, init-env.sh copies it verbatim, and so every
# installation redirected its users to the login page **on their own
# laptop** — with a perfectly healthy server behind it.
#
# Set them only when the answer is genuinely fixed and genuinely yours:
#   NEXTAUTH_URL=https://celmis.example.com
#   PUBLIC_BASE_URL=https://celmis.example.com
#
# ALERT NOTIFICATIONS REQUIRE IT. The Open button on an alert card needs an
# absolute address, and that address must not come from the alert: an alert
# arrives from somebody else's monitoring over a token, and the sender writes
# its own Host header. Built from the request, that button pointed wherever the
# sender said — inside a card carrying this product's branding, delivered to
# the workspace's chat room. So it is read from here or not at all. Left unset,
# alerts still arrive; they arrive without a button.
#
# GOOGLE SIGN-IN REQUIRES IT TOO. Google will only redirect
# back to a URI you registered with it beforehand, so there the address is
# fixed by definition and has to be written down. Email + password sign-in
# needs nothing here.
#
# AUTOMATIC WEBHOOK INSTALL REQUIRES IT. Registering a repository with
# auto-review (or pressing "Install webhook" on Repositories) creates the
# review webhook on GitHub/GitLab/Bitbucket pointing at
# $PUBLIC_BASE_URL/backend/webhook/<provider>/<workspace>. The installer runs
# server-side with no browser request to read a host from, and a provider must
# reach the address from the internet — so unset (or localhost) means the
# install is refused with instructions and the webhook has to be added by hand.
#
# NEXT_PUBLIC_API_BASE is different again: Next.js substitutes it into the
# client bundle AT BUILD TIME, so it belongs to whoever builds the image,
# not to whoever runs it. Setting it here does nothing to a published image.
# For the split dev setup (Next on :3000, FastAPI on :8000, no proxy) put
# it in web/.env.local, where the build will see it.
NEXT_PUBLIC_API_BASE=
NEXTAUTH_URL=
PUBLIC_BASE_URL=
CELMIS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Recovery account ────────────────────────────────────────────────
#
# The ONLY way to obtain global-admin rights: sign in with this email and
# the key below as the password. Both must be set or the path does not
# exist. Without it, an installation whose first user is not an admin has no
# way back in.
CELMIS_MASTER_EMAIL=admin@example.local
# openssl rand -hex 24
CELMIS_MASTER_KEY=

# Read-only token for /api/ops/* — metrics and log tails for an uptime
# checker, and nothing that can change anything.
# openssl rand -hex 24
CELMIS_OPS_TOKEN=

# ── Deployment shape ────────────────────────────────────────────────
#
# single_tenant (default) keeps today's behaviour: where an access rule is
# missing, the request is allowed. multi_tenant inverts that — a missing
# rule means refused — and is what you want the moment a second workspace
# exists. Switch it deliberately: on an installation with no rules
# configured, multi_tenant denies everything until you write some.
CELMIS_DEPLOYMENT_MODE=single_tenant

# The API schema and the Swagger page require a session. Set to 1 to serve
# them to anybody — reasonable on a laptop, not on a public host: it is a
# complete map of ~180 routes.
CELMIS_PUBLIC_API_DOCS=

# ── Embeddings ──────────────────────────────────────────────────────
#
# "gemini" (default) uses the workspace's Google key. "openai_compatible"
# points at any server speaking POST {base_url}/embeddings — Ollama, vLLM,
# llama.cpp, TEI — which is what makes an air-gapped install possible; the
# full recipe is the commented block below.
EMBEDDING_PROVIDER=gemini
# Gemini embeddings are asymmetric: documents and queries are embedded
# differently, which is why retrieval works as well as it does. Off makes
# both sides symmetric.
EMBEDDING_TASK_TYPE_ENABLED=true

# ── Local embeddings (self-hosted) ──────────────────────────────────
#
# Uncomment the block to embed on your own hardware instead of Google's.
# The example is Ollama serving nomic-embed-text on the host; any server
# speaking POST {base_url}/embeddings works the same way.
#
# EGRESS_ALLOW_PRIVATE_NETWORK=1 is REQUIRED for a 127.0.0.1 / compose-
# service EMBEDDING_BASE_URL. The egress policy classifies private and
# loopback addresses separately and fails closed on them, so without this
# switch the exact block below indexes nothing and every embedding error
# reads `egress_blocked`. The switch opens the LAN and ONLY the LAN —
# public hosts and the cloud metadata address (169.254.169.254) stay
# refused.
#
# EMBEDDING_DIMENSIONS must be the width the model REALLY returns
# (nomic-embed-text: 768; bge-m3 / e5-large: 1024). The Qdrant collection
# is created at this width, and a wrong number is now refused at the first
# embedding (EmbeddingConfigMismatch names both numbers) instead of being
# discovered as a green run over an empty index. The line ships commented,
# not blank, on purpose: an EMPTY value is not "default" — pydantic refuses
# "" for an integer and the API would not start.
#
# The prefixes are how nomic/e5-style models tell documents from queries:
# the OpenAI embeddings schema has no task_type field, so the side travels
# as literal text. nomic-*: "search_document: " / "search_query: ";
# e5-*: "passage: " / "query: ". Models that want none: leave unset. The
# quotes keep the trailing space.
#
# SWITCHING THE EMBEDDING MODEL (or its width) MEANS A FULL RE-INDEX:
# vectors from two models do not live in one collection.
#
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSIONS=768
# EMBEDDING_TIMEOUT_SECONDS=60
# EMBEDDING_DOCUMENT_PREFIX="search_document: "
# EMBEDDING_QUERY_PREFIX="search_query: "
# EGRESS_ALLOW_PRIVATE_NETWORK=1

# ── LiteLLM gateway (optional) ──────────────────────────────────────
#
# COMPOSE_PROFILES=gateway starts the proxy; leave empty for direct
# provider keys. LITELLM_SALT_KEY has the same warning as
# CREDENTIAL_MASTER_KEY: rotating it orphans every stored virtual key.
COMPOSE_PROFILES=
# openssl rand -hex 24
LITELLM_MASTER_KEY=
# openssl rand -hex 24 — never rotate
LITELLM_SALT_KEY=
LITELLM_DB=litellm
LITELLM_PROXY_URL=http://litellm:4000

# ── Your own LiteLLM proxy (provider "litellm") ─────────────────────
#
# NOT the gateway above: an existing company proxy that Celmis calls with a
# virtual key. Its URL, key and models are set ONLY per workspace, by a
# workspace admin, on Settings → LLM — there is no env fallback. The URL must
# be https and resolve to public addresses only. Escape hatch for a proxy on
# your LAN: list its host here (JSON list; exact host or subdomain). Listed
# hosts may resolve to private/loopback addresses, never link-local
# (169.254.x, cloud metadata). EGRESS_ALLOW_PRIVATE_NETWORK does not apply.
# LITELLM_PROXY_ALLOWED_HOSTS=["litellm.corp.internal"]

# ── Self-hosted GitLab (optional) ───────────────────────────────────
#
# A workspace admin sets a self-hosted GitLab's address on Git connections →
# GitLab → "GitLab URL" (e.g. https://gitlab.example.com or
# https://example.com/gitlab). The Celmis SERVER connects to it — an
# internal-only GitLab is unreachable from a cloud VM unless a route
# (VPN, peering) exists. By default the URL must be https and resolve to
# public addresses only; these relax that, per host, for the operator only.
#
# Hosts that may resolve to private/loopback addresses (JSON list; exact
# host or subdomain). Never link-local (169.254.x, cloud metadata).
# EGRESS_ALLOW_PRIVATE_NETWORK does not apply.
# GITLAB_ALLOWED_HOSTS=["gitlab.corp.internal"]
# Hosts that may be reached over plain http:// (JSON list; exact host).
# The token then travels unencrypted — prefer https.
# GITLAB_HTTP_ALLOWED_HOSTS=[]
# PEM bundle of the private CA that signed the GitLab certificate, as a path
# INSIDE the api container (mount it read-only). Added to the public roots
# for self-hosted GitLab API calls and clones. There is deliberately no
# option to disable certificate verification.
# GITLAB_CA_BUNDLE=/run/secrets/gitlab-ca.pem

# ── Jira task context (optional) ────────────────────────────────────
# A workspace connects its Jira on the Connections page (Atlassian Cloud:
# https://<site>.atlassian.net, email + API token); the review then reads the
# task a PR names and checks the change against it. Only a Jira Data Center /
# self-hosted site needs anything here: list its host (JSON list; exact host
# or subdomain), which may then resolve to a private address.
# JIRA_ALLOWED_HOSTS=["jira.corp.internal"]
# Seconds a read issue is served without asking Jira again (then one cheap
# "has it changed" request decides), the per-request timeout in seconds, and
# the longest task description given to the model, in characters.
# JIRA_CACHE_TTL_SECONDS=600
# JIRA_TIMEOUT_SECONDS=8
# JIRA_MAX_DESCRIPTION_CHARS=12000

# ── Google sign-in (optional) ───────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=

# ── Celmis Enterprise licence (optional) ────────────────────────────
# Single sign-on and review analytics are enterprise features (LICENSE_EE,
# ee/README.md). Without a valid licence the API runs as the community
# edition and does not mount them; everything else works the same. The
# licence is an offline signed token, checked at API start-up — it never
# calls home. Set ONE of these on the API (the variable wins if both are set):
#   CELMIS_LICENSE_KEY   the token itself (eyJhbGciOiJFZERTQSIs...)
#   CELMIS_LICENSE_FILE  path, inside the API container, to a file holding it
# An invalid or expired licence is logged as a WARNING (never the token) and
# the API starts as community. /admin/health shows the edition and expiry.
CELMIS_LICENSE_KEY=
CELMIS_LICENSE_FILE=

# ── Single sign-on: Keycloak / OIDC (optional, enterprise) ──────────
# Requires an enterprise licence that grants "sso" (above): without one the
# API does not mount /api/auth/oidc and the login page shows no SSO button,
# even with everything below set.
# Off unless issuer + client id + secret are all set. The web app runs the
# OIDC login and hands the id_token to the API, which verifies it against
# the issuer's own JWKS (signature, iss, aud, exp). Both containers read
# these names. Register the redirect URI <your address>/api/auth/callback/oidc
# with the IdP, so NEXTAUTH_URL must be fixed here, as for Google.
# A new SSO identity is accepted ONLY when the IdP says its email is verified,
# whether it links an existing account or creates one.
# Deprovisioning: a user disabled (or stripped of OIDC_ADMIN_ROLE) in the IdP
# keeps the Celmis session they already hold until it expires (30 days); an
# SSO-only session is not renewed, so the next sign-in asks the IdP again.
# For an immediate cut-off, also disable the user in Celmis (admin page/CLI).
# Rollback: SSO-only users are stored with auth_method 'oidc', which builds
# without SSO cannot read; see src/users/models.py before downgrading.
# A local Keycloak to try it with: deploy/keycloak/docker-compose.yml
#   AUTH_OIDC_ISSUER     e.g. https://sso.example.com/realms/celmis
#   AUTH_OIDC_NAME       button label, "Sign in with <name>" (default SSO)
#   OIDC_ADMIN_ROLE      realm role / group that makes a user a Celmis admin;
#                        granted at every sign-in (realm_access.roles,
#                        resource_access.<AUTH_OIDC_CLIENT_ID>.roles — not
#                        other clients' roles — roles or groups claim)
#   OIDC_ADMIN_ROLE_SYNC true = also REVOKE admin from users without the role
#                        at their next SSO sign-in (never the master account)
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_NAME=
OIDC_ADMIN_ROLE=
OIDC_ADMIN_ROLE_SYNC=
# false = no email+password sign-in or signup (web and API) — SSO only.
# The recovery account above (CELMIS_MASTER_KEY) keeps working: it is the
# way back in when the IdP is down. On the login page it sits behind
# "Administrator sign-in".
AUTH_PASSWORD_LOGIN=

# ── Web push (optional) ─────────────────────────────────────────────
#
# Generate a pair with `npx web-push generate-vapid-keys`. VAPID_SUBJECT is
# sent to the push service on every delivery — use a role address, not a
# personal one.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# ── Review webhooks (optional) ──────────────────────────────────────
# shared with GitHub
REVIEW_WEBHOOK_SECRET=
# shared with GitLab
REVIEW_GITLAB_TOKEN=
# shared with Bitbucket
REVIEW_BITBUCKET_SECRET=

# ── Observability overlay (optional) ────────────────────────────────
#
# Only read when you run with `-f docker-compose.observability.yml`. The
# overlay REFUSES TO START without a password rather than falling back to
# `admin`, which is what it used to do — on a port that was published to
# every interface, so switching on monitoring opened Grafana, Prometheus and
# an unauthenticated Loki to the internet. All three are bound to 127.0.0.1
# now; reach them with `ssh -L 3100:localhost:3100 you@your-server`.
#
# init-env.sh fills this in.
GRAFANA_ADMIN_PASSWORD=

# ── MCP ─────────────────────────────────────────────────────────────
#
# THE ONE ADDRESS YOU DO HAVE TO WRITE DOWN. Everything else on this box
# works out the address it was reached at; the MCP endpoint cannot, because
# refusing a host nobody declared is exactly what its DNS-rebinding guard is
# for. Leave this empty on a box reached at anything but localhost and every
# MCP call answers `421 Invalid Host header` — the whole endpoint, not a
# degraded version of it.
#
# Comma-separated, host or host:port, no scheme:
#   MCP_ALLOWED_HOSTS=celmis.example.com
#
# PUBLIC_BASE_URL above is read the same way when you have set it.
MCP_ALLOWED_HOSTS=

# ── MCP access: who may read which repository, who issues tokens ─────
#
# BREAKING in 2.3.7: a repository with no team rule and no team grant is
# visible to owners, admins and the superadmin only, until you grant a team
# (Admin > Access / Admin > Teams, or `analyzer access bootstrap`).
# Set `open` to restore the old behaviour on a single_tenant install; it is
# ignored under multi_tenant.
CELMIS_UNRULED_REPO_ACCESS=deny

# MCP tokens are issued by the superadmin for one person with an explicit
# list of repositories (Admin > MCP tokens). Set true to let every signed-in
# user mint their own token as well (it can then never exceed their own access).
CELMIS_MCP_SELF_SERVICE=false
# superadmin | platform_admin (any global admin may issue)
CELMIS_MCP_TOKEN_ISSUERS=superadmin
CELMIS_MCP_TOKEN_MAX_DAYS=90

# Code from an archive (superadmin): size limit in bytes (default 250 MiB) and
# uploads per rate-limit window. A proxy in front must allow the same body size.
CELMIS_MAX_UPLOAD_BYTES=262144000
CELMIS_RL_UPLOAD=10
CELMIS_RL_UPLOAD_PART=600
# Chunked upload: part size in bytes (default 32 MiB, max 90 MiB) and session lifetime.
CELMIS_UPLOAD_CHUNK_BYTES=33554432
CELMIS_UPLOAD_SESSION_TTL=86400
# refuse | accept — tokens issued before per-person grants (no jti)
CELMIS_MCP_LEGACY_TOKENS=refuse
CELMIS_MCP_AUDIT_RETENTION_DAYS=180

# Per-token limits of the MCP endpoints (0 switches the rate limit or the
# concurrency cap off) and the time limit of one call, in seconds.
CELMIS_MCP_RATE_PER_MINUTE=120
CELMIS_MCP_MAX_CONCURRENT=4
CELMIS_MCP_CALL_TIMEOUT_SECONDS=60
# Extra path globs the MCP tools treat as secret files, a JSON list
# (added to the built-in list; nothing here can remove an entry from it).
# Empty, a comma list or a JSON list, e.g. ["deploy/private/**"].
SECRET_PATH_GLOBS_EXTRA=
# Rotating the signing secret: put the OLD one here until its tokens expire.
CELMIS_JWT_SECRET_PREVIOUS=
MCP_JWT_SECRET_PREVIOUS=
# 1 = trust X-Forwarded-For for the client address (only behind a proxy you run).
# CELMIS_TRUST_PROXY=1

# ── Background jobs ─────────────────────────────────────────────────
# Issues backlog sweep (docs/ISSUES_BACKLOG.md): hours between sweeps (0 = off),
# delay before the first one, pause between branches, and the debounce of a
# recheck asked by a merge or a push. CELMIS_DISABLE_ISSUES_SWEEP=1 is a hard off.
CELMIS_ISSUES_SWEEP_INTERVAL_HOURS=24
CELMIS_ISSUES_SWEEP_FIRST_DELAY_SECONDS=300
CELMIS_ISSUES_SWEEP_STAGGER_SECONDS=5
CELMIS_ISSUES_RECHECK_DEBOUNCE_SECONDS=30
# CELMIS_DISABLE_ISSUES_SWEEP=1
# Productivity metrics (docs/PRODUCTIVITY.md): minutes between ticks (0 = off),
# delay before the first tick and the time budget of one sync slice.
# CELMIS_DISABLE_PRODUCTIVITY_SCHED=1 is a hard off.
CELMIS_PRODUCTIVITY_INTERVAL_MINUTES=60
CELMIS_PRODUCTIVITY_FIRST_DELAY_SECONDS=180
CELMIS_PRODUCTIVITY_JOB_BUDGET_SECONDS=480
# CELMIS_DISABLE_PRODUCTIVITY_SCHED=1
# Learning from feedback (docs/MEMORIES_AND_LEARNING.md): off | weekly.
# CELMIS_DISABLE_LEARNING_SCHED=1 stops the loop entirely.
REVIEW_LEARNING_RULES_SCHEDULE=off
# Thresholds (defaults shown): similarity 0.5-1.0, weighted dismissals, days.
# REVIEW_LEARNING_SIMILARITY=0.90
# REVIEW_LEARNING_MIN_DISMISSALS=2
# REVIEW_LEARNING_WINDOW_DAYS=180
# REVIEW_LEARNING_HALF_LIFE_DAYS=90
# REVIEW_LEARNING_RULES_MIN_EVIDENCE=3
# REVIEW_LEARNING_COLLECTION=celmis_finding_signals
# CELMIS_DISABLE_LEARNING_SCHED=1

# ── PR commands and chat (docs/PR_COMMANDS.md) ──────────────────────
# The handle people type to address the reviewer, the marker style of its
# comments (auto | html | refdef | zwsp), and the limits of one chat turn.
REVIEW_BOT_HANDLE=@celmis
REVIEW_MARKER_STYLE=auto
REVIEW_CHAT_MAX_CONTEXT_CHARS=60000
REVIEW_CHAT_MAX_REPLY_CHARS=6000
REVIEW_CHAT_TIMEOUT_SECONDS=90
# Characters of memories put into one review prompt.
REVIEW_MEMORY_PROMPT_CHARS=3000

# ── Git provider tokens (optional) ──────────────────────────────────
#
# Only needed for the CLI inside the container
# (`docker compose exec api analyzer ...`). Every user can save their own
# through the Connections page instead, which is the normal path — these
# exist so a headless operator has one too. docker-compose reads all three,
# so they are written down here rather than left for someone to discover
# from a compose file.
GITHUB_TOKEN=
GITLAB_TOKEN=
BITBUCKET_TOKEN=

# ── Mail (optional) ─────────────────────────────────────────────────
#
# Digest and invite email. Without SMTP the product still works; it simply
# does not send. Most self-hosted installs have no SMTP at all.
SMTP_PASSWORD=

# ── Sandbox ─────────────────────────────────────────────────────────
#
# Shared secret between the api and the sandbox container. The sandbox
# refuses to start without it (src/sandbox/server.py) — "without it every
# request would be accepted, and this process runs commands".
#
# It used to live here as a comment only, because the production deploy
# generates it on the server and appends it. But `scripts/init-env.sh` takes
# its list of secrets FROM THIS FILE, so a variable that is only a comment is
# invisible to it: a local install ran the documented one-line setup, saw
# "filled 12", and got a sandbox that would not start. Now it is a real
# assignment, generated locally; the deploy replaces this line with the
# server's own token rather than appending a second one.
#
# Left empty, the stack still comes up and the api says at startup what is
# lost. docker-compose deliberately does NOT mark it required: interpolation
# is resolved for the whole file, so `:?` here would refuse to start postgres
# over a feature most installs never use.
SANDBOX_TOKEN=
#
# THE ADDRESS IS NOT YOURS TO CHOOSE. `sandbox` is a compose service name and
# 8900 is the port its Dockerfile exposes; both are internal to the stack and
# neither is reachable from outside it. Leave this empty and compose supplies
# the pair from one place.
#
# It said 8080 here. The sandbox listens on 8900, `.env` beats the compose
# default, and so every install that copied this file had an api that could
# not reach its own sandbox: `available()` false, every run refused with
# ECONNREFUSED, and the agent quietly doing without the one component that
# exists so untrusted code does not execute next to the credential store.
# A test already asserted the port — against docker-compose.yml, which is not
# the file anybody edits.
SANDBOX_URL=
#
# Which addresses ARE the sandbox. api and the sandbox share a network because
# api has to reach it, and a Docker network carries traffic both ways — so the
# sandbox, which runs the code under review, can address api. Every route
# needs a token it never receives; /healthz did not. This subnet is what lets
# api recognise and refuse those calls, and docker-compose.yml pins the same
# value on the network so the two cannot drift.
#
# Change it only if 172.28.90/24 collides with something on your host; change
# it in one place and both follow. Empty disables the check and says so in the
# api log at startup.
SANDBOX_NET_SUBNET=

# Thinking budget for Gemini 3.x, in tokens. The provider default is DYNAMIC —
# the model decides per call, so two runs over the same diff cost different
# amounts and a benchmark is not reproducible. Set it to fix that.
#   -1  dynamic (provider default; changes nothing)
#    0  off — the cheapest baseline to measure against
#  128+ a floor; Flash accepts up to 24576
GEMINI_THINKING_BUDGET=-1

# Which model each surface uses out of the box. TWO variables, not one, and
# the reason is concurrency rather than quality.
#
# Chat and documentation make ONE call at a time, so the stronger model costs
# nothing but money. Review makes THREE at once — defect, contract and
# security run in parallel — and with two queue workers, two overlapping
# reviews make six. Measured against Google directly, same prompt, same day:
#
#   gemini-3.1-pro-preview   3 concurrent → 3/3, slowest 51.6s
#                            4 concurrent → 3/4, one HTTP 503
#   gemini-3.6-flash         3 concurrent → 3/3, slowest 10.0s
#                            4 concurrent → 4/4, slowest 11.1s
#
# A stronger model is measurably better at this task — SWR-Bench: identical
# precision, 67% more recall — but a call that returns 503 has no recall at
# all, and a fresh install meets that on its first pull request.
#
# To review with Pro, set GEMINI_REVIEW_MODEL below AND lower
# REVIEW_AGENT_CONCURRENCY to 2. The numbers say those two go together.
GEMINI_GENERATION_MODEL=gemini-3.1-pro-preview
GEMINI_REVIEW_MODEL=gemini-3.6-flash

# Reply ceiling for the review agents. Gemini 3.x counts reasoning against
# the same budget, so a ceiling sized for the answer alone truncates the JSON.
REVIEW_AGENT_MAX_OUTPUT_TOKENS=16384
# The verifier and the compliance pass answer in short structured replies and
# keep their own, smaller floors. A per-agent setting in the UI can raise them.
REVIEW_VERIFIER_MAX_OUTPUT_TOKENS=1024
REVIEW_COMPLIANCE_MAX_OUTPUT_TOKENS=256
# How many review agents call the provider AT ONCE. Six agents used to open
# six connections per PR — ConnectError on a weak uplink, 503 on Gemini. The
# scanners (cve, structural) run in their own pool and do not count here.
REVIEW_AGENT_CONCURRENCY=3

# How many queued jobs the worker runs at once. Each review already fans out
# to REVIEW_AGENT_CONCURRENCY provider calls, so this multiplies.
CELMIS_SYNC_WORKER_CONCURRENCY=2

# Sampling temperature for the review agents. Low on purpose — the same
# diff read twice should not produce two different findings. Models that
# accept only their own default have the parameter dropped instead.
REVIEW_AGENT_TEMPERATURE=0.1

# ── Clocks ──────────────────────────────────────────────────────────
#
# Every number below was, until recently, a literal somewhere in the code
# that nothing named and no operator could reach. They are here because a
# knob is only settable if the value can reach the process that reads it:
# ReviewSettings declares an env_file, the image carries no .env, so the
# only route in is docker-compose's `environment:` block — and that block
# reads these names.
#
# THEY NEST, and a test enforces it:
#     REVIEW_LLM_TIMEOUT_SECONDS × (1 + RETRY_FACTOR)  ≤  REVIEW_TIMEOUT_SECONDS
# Raise one and the other has to follow. /backend/healthz reports all of
# them as the process resolved them, which is how you check what arrived.

# Wall clock for ONE review. Not a kill: past it the tail stages
# (breaking-change, compliance) stand down, the findings in hand are posted,
# and the comment opens with "REVIEW CUT SHORT". Measured over 517 real
# reviews — median 74s, p90 328s, p99 1486s — so 300 would cut 14.3% of them
# and 900 cuts 2.3%, which is the tail that genuinely hangs.
REVIEW_TIMEOUT_SECONDS=900
# Deadline for one call to a model. A reasoning model on a large diff thinks
# for longer than the 120s this inherited: sixteen agent failures in eight
# hours, every one of them this. Raise it for a slow model — 600 suits
# gpt-5.2 at medium effort, whose whole reviews median 337s.
REVIEW_LLM_TIMEOUT_SECONDS=300
# How much longer the SECOND attempt gets when the first died ON the
# deadline. 1.0 turns the widening off. Resending into the same wall is a
# second guaranteed failure at full price, which is what it used to do.
REVIEW_LLM_TIMEOUT_RETRY_FACTOR=2.0
# A diff larger than this is refused with a named reason instead of being
# silently cut to 50k characters and reviewed as if whole.
REVIEW_MAX_DIFF_SIZE_BYTES=500000
# Wall clock for the CVE agent's OSV sweep. A judgement about lockfile size:
# a monorepo with thousands of packages sweeps more batches than a small
# repository, and the sweep now stops on its own and reports what it missed.
REVIEW_CVE_LOOKUP_TIMEOUT_SECONDS=120

# The LLM false-positive veto. OFF by default: it is a second model call over
# every finding in the review — the slowest single call the pipeline makes —
# and whether it earns its price is a judgement about one repository's
# tolerance for noise. Switch it on per repository at /admin/review-policies.
# The DETERMINISTIC prefilter (dedup, near-duplicate clustering, the rule
# deny-list, the confidence floor, the severity sort) always runs and is not
# this.
REVIEW_VERIFIER_ENABLED=false

# Deadline for one documentation-generation call, and its resend budget.
# Stated because LiteLLM's default of three resends quietly makes any
# deadline a ceiling four times its own size.
GENERATION_TIMEOUT_SECONDS=600
GENERATION_NUM_RETRIES=1
# Deadline for a whole Claude-agent documentation SESSION — up to 24 tool
# using exchanges, not one completion. There was none, and a session that
# stops producing messages waits forever while the job's lease keeps saying
# the worker is alive. Which it is; that is the problem.
GENERATION_AGENT_TIMEOUT_SECONDS=1800

# Deadline for one Gemini request on the QA exploration path. It existed as a
# setting for months and was read by no code path: `genai.Client` was built
# with no transport options, so those calls had no timeout at all.
GEMINI_TIMEOUT_SECONDS=120

# How long a queued job may run before another worker may reclaim it. The
# handler renews this while it works, so it is a ceiling on SILENCE, not a
# guess about duration — 3.5% of 517 reviews outlived the old fixed lease and
# were run twice, paid for twice and posted twice.
CELMIS_JOB_LEASE_SECONDS=600

# The sandbox queues for a free slot AND THEN runs the command, so its two
# clocks add up. The caller declares how long it will wait beyond the
# command's own budget; the sandbox bounds its queue wait by that rather than
# by its own ceiling alone. Two independent numbers is how a caller came to
# hang up on jobs the sandbox went on running to completion.
SANDBOX_CLIENT_WAIT_BUDGET=180
SANDBOX_SLOT_WAIT=120

# ─── Images ──────────────────────────────────────────────────────────
#
# Where the three Celmis images come from, and which build to run. The
# compose file pins `${CELMIS_REGISTRY}/celmis-{api,web,sandbox}:${CELMIS_TAG}`
# and builds nothing: building three images on the machine that runs them was
# measured at 485 seconds and 4.2GB for `api` alone, with no cache reuse.
#
# Change CELMIS_REGISTRY if you host your own copies — a fork publishes under
# its own owner, and the value was hard-coded here until it was not.
# Developers who want a local build use docker-compose.dev.yml instead.
CELMIS_REGISTRY=ghcr.io/celmis-labs
CELMIS_TAG=latest
